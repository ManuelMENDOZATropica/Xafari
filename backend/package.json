		"winston": "^3.17.0",
		"yaml": "^2.8.0"
	},
	"jest": {
		"verbose": true,
		"roots": [
			"./tests"
		],
		"testMatch": [
			"**/*.js"
		],
		"collectCoverageFrom": [
			"controllers/**/*.js",
			"services/**/*.js",
			"middleware/**/*.js",
			"utils/**/*.js"
		],
		"transform": {
			"^.+\\.js$": "babel-jest"
