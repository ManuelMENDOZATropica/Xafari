{
	"name": "xafari-backend",
	"version": "1.0.0",
	"description": "API de Xafari (Express + Sequelize)",
	"main": "server.js",
	"scripts": {
		"start": "node server.js",
		"dev": "node server.js",
		"test": "NODE_ENV=test jest --runInBand",
		"migrate": "node migrations/umzug.js",
		"seed": "node scripts/seed.js",
		"generate-qrs": "node scripts/generate-qrs.js"
	},
	"license": "ISC",
	"devDependencies": {
		"jest": "^29.7.0",
		"qrcode": "^1.5.4",
		"sqlite3": "^5.1.7",
		"supertest": "^7.3.2"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"dotenv": "^16.6.1",
		"express": "~4.22.1",
		"express-rate-limit": "^8.7.5",
		"express-validator": "^7.3.2",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"pg-hstore": "^2.3.4",
		"sequelize": "^6.37.8",
		"swagger-ui-express": "^5.0.1",
		"umzug": "^3.8.3",
		"winston": "^3.19.0",
		"yaml": "^2.9.1"
	},
	"jest": {
		"verbose": false,
		"testEnvironment": "node",
		"roots": [
			"./tests"
		],
		"testMatch": [
			"**/*.test.js"
		],
		"setupFilesAfterEnv": [
			"./jest.setup.js"
		],
		"collectCoverageFrom": [
			"controllers/**/*.js",
			"services/**/*.js",
			"middleware/**/*.js",
			"utils/**/*.js"
		]
	},
	"allowScripts": {
		"sqlite3@5.1.7": true,
		"bcrypt@6.0.0": true
	},
	"private": true,
	"engines": {
		"node": ">=20"
	}
}
