# Copia este archivo a .env (no se sube a git).
# En desarrollo nada es obligatorio: sin DATABASE_URL usa SQLite (database.sqlite)
# y JWT_SECRET/QR_SECRET tienen valores de desarrollo.

NODE_ENV=development
PORT=3000

# ── Base de datos ─────────────────────────────────────────────
# Postgres (obligatorio en producción). En desarrollo, si se define, se usa en vez de SQLite.
# DATABASE_URL=postgres://usuario:password@host:5432/xafari
# SSL: por defecto requiere SSL sin verificar certificado (comportamiento histórico en Render).
# DB_SSL=false            # Postgres local sin SSL
# DB_SSL_CA=/ruta/ca.pem  # o el PEM pegado: verifica el certificado del servidor
# DB_POOL_MAX=10
# DB_LOGGING=false        # true = loguea SQL (incluye datos personales: no en producción)
# SQLITE_STORAGE=database.sqlite

# ── Secretos (obligatorios en producción; el server no arranca sin ellos) ──
# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# QR_SECRET=              # firma los QR impresos: si cambia, hay que reimprimirlos
# JWT_EXPIRES_IN=7d

# ── Frontend / CORS ───────────────────────────────────────────
# URL pública del front; va dentro de los QR: ${PUBLIC_APP_URL}/q/<activityId>?k=<code>
PUBLIC_APP_URL=https://xafari-phi.vercel.app
# Orígenes permitidos, separados por coma (por defecto en producción: https://xafari-phi.vercel.app)
# CORS_ORIGINS=https://xafari-phi.vercel.app,https://xafari.xcaret.com

# ── Proxy y rate limit ────────────────────────────────────────
# TRUST_PROXY=1             # saltos de proxy (Render = 1); "false" para desactivar
# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_MAX=1000       # por IP y ventana (el parque comparte IP: no bajarlo mucho)
# LOGIN_LIMIT_MAX=10        # por IP + email cada 15 min
# REGISTER_LIMIT_MAX=30     # por IP cada hora

# ── Juego ─────────────────────────────────────────────────────
# XPERIENCIA_COOLDOWN_SECONDS=180
# APP_TIMEZONE=America/Cancun

# ── Otros ─────────────────────────────────────────────────────
# ENABLE_DOCS=false         # Swagger en /docs (por defecto solo fuera de producción)
# LOG_LEVEL=info
